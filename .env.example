NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tutordesk_app:tutordesk_app_dev_password@localhost:5433/tutor_desk?schema=public
DIRECT_URL=postgresql://tutordesk:tutordesk_dev_password@localhost:5433/tutor_desk?schema=public
TUTORDESK_APP_PASSWORD=tutordesk_app_dev_password
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
JOB_SCHEDULE_CRON=0 2 * * *
# Disable only in isolated test runs; general requests fail open if Redis is down.
RATE_LIMIT_ENABLED=true
# Enable only when deployed behind a trusted proxy that overwrites forwarding headers.
TRUST_PROXY=false
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
