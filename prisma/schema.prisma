generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  TEACHER
  PARENT
}

enum Plan {
  FREE
  PRO
}

enum InviteRole {
  TEACHER
  PARENT
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sentInvites  Invite[]     @relation("InviteInviter")
  parentLinks  ParentStudent[]
}

model Center {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  plan        Plan         @default(FREE)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  students    Student[]
  invites     Invite[]
  parentLinks ParentStudent[]
}

model Student {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  name      String
  grade     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  invites   Invite[]
  parentLinks ParentStudent[]

  @@unique([centerId, id])
  @@index([centerId])
}

model Invite {
  id              String      @id @default(uuid()) @db.Uuid
  centerId        String      @db.Uuid
  invitedByUserId String      @db.Uuid
  email           String
  role            InviteRole
  studentId       String?     @db.Uuid
  tokenHash       String      @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  center          Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  invitedBy       User        @relation("InviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  student         Student?    @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)

  @@index([centerId])
}

model ParentStudent {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  userId    String   @db.Uuid
  studentId String   @db.Uuid
  createdAt DateTime @default(now())
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)

  @@unique([userId, studentId])
  @@index([centerId])
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  centerId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([userId, centerId])
  @@index([centerId])
}
