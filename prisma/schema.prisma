generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  TEACHER
  PARENT
}

enum Plan {
  FREE
  PRO
}

enum NotificationType {
  FEE_REMINDER
}

enum NotificationChannel {
  LOG
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum JobOutboxStatus {
  PENDING
  DISPATCHING
  DISPATCHED
}

enum InviteRole {
  TEACHER
  PARENT
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sentInvites  Invite[]     @relation("InviteInviter")
  parentLinks  ParentStudent[]
  attendanceMarks Attendance[]
  waivedCharges FeeCharge[] @relation("FeeChargeWaiver")
  recordedPayments Payment[] @relation("PaymentRecorder")
  voidedPayments Payment[] @relation("PaymentVoider")
  notifications Notification[] @relation("NotificationParent")
}

model Center {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  plan        Plan         @default(FREE)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  students    Student[]
  invites     Invite[]
  parentLinks ParentStudent[]
  batches     Batch[]
  feePlans    FeePlan[]
  studentFees StudentFee[]
  feeCharges  FeeCharge[]
  payments    Payment[]
  paymentAllocations PaymentAllocation[]
  counters    CenterCounter[]
  notifications Notification[]
  auditLogs   AuditLog[]
  jobOutbox   JobOutbox[]
}

model Student {
  id            String          @id @default(uuid()) @db.Uuid
  centerId      String          @db.Uuid
  name          String
  grade         String?
  phone         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  center        Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  invites       Invite[]
  parentLinks   ParentStudent[]
  enrollments   BatchStudent[]
  examResults   ExamResult[]
  studentFees   StudentFee[]
  payments      Payment[]
  notifications Notification[]

  @@unique([centerId, id])
  @@index([centerId])
}

model Invite {
  id              String      @id @default(uuid()) @db.Uuid
  centerId        String      @db.Uuid
  invitedByUserId String      @db.Uuid
  email           String
  role            InviteRole
  studentId       String?     @db.Uuid
  tokenHash       String      @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  center          Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  invitedBy       User        @relation("InviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  student         Student?    @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)

  @@index([centerId])
}

model Batch {
  id          String          @id @default(uuid()) @db.Uuid
  centerId    String          @db.Uuid
  name        String
  subject     String?
  schedule    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  center      Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teachers    BatchTeacher[]
  enrollments BatchStudent[]
  exams       Exam[]
  feePlans    FeePlan[]

  @@unique([centerId, id])
  @@index([centerId])
}

model BatchTeacher {
  id        String     @id @default(uuid()) @db.Uuid
  centerId  String     @db.Uuid
  batchId   String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now())
  batch     Batch      @relation(fields: [centerId, batchId], references: [centerId, id], onDelete: Cascade)
  membership Membership @relation(fields: [centerId, userId], references: [centerId, userId], onDelete: Cascade)

  @@unique([batchId, userId])
  @@index([centerId])
  @@index([centerId, userId])
}

model BatchStudent {
  id        String       @id @default(uuid()) @db.Uuid
  centerId  String       @db.Uuid
  batchId   String       @db.Uuid
  studentId String       @db.Uuid
  enrolledAt DateTime    @default(now())
  batch     Batch        @relation(fields: [centerId, batchId], references: [centerId, id], onDelete: Cascade)
  student   Student      @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)
  attendance Attendance[]

  @@unique([batchId, studentId])
  @@unique([centerId, batchId, studentId])
  @@index([centerId])
  @@index([centerId, studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  centerId       String           @db.Uuid
  batchId        String           @db.Uuid
  studentId      String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  enrollment     BatchStudent     @relation(fields: [centerId, batchId, studentId], references: [centerId, batchId, studentId], onDelete: Restrict)
  markedBy      User             @relation(fields: [markedByUserId], references: [id], onDelete: Restrict)

  @@unique([batchId, studentId, date])
  @@index([centerId])
  @@index([centerId, batchId, date])
  @@index([centerId, studentId, date])
}

model Exam {
  id        String        @id @default(uuid()) @db.Uuid
  centerId  String        @db.Uuid
  batchId   String        @db.Uuid
  name      String
  maxMarks  Int
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  batch     Batch         @relation(fields: [centerId, batchId], references: [centerId, id], onDelete: Restrict)
  results   ExamResult[]

  @@unique([centerId, id])
  @@index([centerId])
  @@index([centerId, batchId, date])
}

model ExamResult {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  examId    String   @db.Uuid
  studentId String   @db.Uuid
  marks     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [centerId, examId], references: [centerId, id], onDelete: Cascade)
  student   Student  @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([centerId])
  @@index([centerId, studentId])
}

model ParentStudent {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  userId    String   @db.Uuid
  studentId String   @db.Uuid
  createdAt DateTime @default(now())
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)

  @@unique([userId, studentId])
  @@index([centerId])
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  centerId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  batchAssignments BatchTeacher[]

  @@unique([userId, centerId])
  @@unique([centerId, userId])
  @@index([centerId])
}

enum FeeFrequency {
  MONTHLY
  ONE_TIME
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

model FeePlan {
  id            String       @id @default(uuid()) @db.Uuid
  centerId      String       @db.Uuid
  batchId       String       @db.Uuid
  name          String
  amountPaise   BigInt       @db.BigInt
  frequency     FeeFrequency
  dueDay        Int?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  center        Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  batch         Batch        @relation(fields: [centerId, batchId], references: [centerId, id], onDelete: Restrict)
  studentFees   StudentFee[]

  @@unique([centerId, id])
  @@index([centerId])
  @@index([centerId, batchId])
}

model StudentFee {
  id                 String      @id @default(uuid()) @db.Uuid
  centerId           String      @db.Uuid
  studentId          String      @db.Uuid
  feePlanId          String      @db.Uuid
  customAmountPaise  BigInt?     @db.BigInt
  startDate          DateTime    @db.Date
  endDate            DateTime?   @db.Date
  createdAt          DateTime    @default(now())
  center             Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student            Student     @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Restrict)
  feePlan            FeePlan     @relation(fields: [centerId, feePlanId], references: [centerId, id], onDelete: Restrict)
  charges            FeeCharge[]

  @@unique([centerId, id])
  @@unique([centerId, id, studentId])
  @@index([centerId])
  @@index([centerId, studentId])
  @@index([centerId, feePlanId])
}

model FeeCharge {
  id              String            @id @default(uuid()) @db.Uuid
  centerId        String            @db.Uuid
  studentId       String            @db.Uuid
  studentFeeId    String            @db.Uuid
  periodStart     DateTime          @db.Date
  dueDate         DateTime          @db.Date
  amountPaise     BigInt            @db.BigInt
  description     String
  waivedAt        DateTime?
  waivedByUserId  String?           @db.Uuid
  waiveReason     String?
  createdAt       DateTime          @default(now())
  center          Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentFee      StudentFee        @relation(fields: [centerId, studentFeeId, studentId], references: [centerId, id, studentId], onDelete: Restrict)
  waivedBy        User?             @relation("FeeChargeWaiver", fields: [waivedByUserId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@unique([centerId, id])
  @@unique([studentFeeId, periodStart])
  @@index([centerId])
  @@index([centerId, studentId, dueDate])
  @@index([centerId, dueDate])
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  centerId          String             @db.Uuid
  studentId         String             @db.Uuid
  amountPaise       BigInt             @db.BigInt
  paidOn            DateTime           @db.Date
  method            PaymentMethod
  reference         String?
  receiptNumber     String
  idempotencyKey    String?
  recordedByUserId  String             @db.Uuid
  voidedAt          DateTime?
  voidedByUserId    String?            @db.Uuid
  voidReason        String?
  createdAt         DateTime           @default(now())
  center            Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student           Student            @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Restrict)
  recordedBy        User               @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedBy          User?              @relation("PaymentVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  allocations       PaymentAllocation[]

  @@unique([centerId, id])
  @@unique([centerId, receiptNumber])
  @@unique([centerId, idempotencyKey])
  @@index([centerId])
  @@index([centerId, studentId, paidOn])
  @@index([centerId, paidOn])
}

model PaymentAllocation {
  id            String     @id @default(uuid()) @db.Uuid
  centerId      String     @db.Uuid
  paymentId     String     @db.Uuid
  chargeId      String     @db.Uuid
  amountPaise   BigInt     @db.BigInt
  center        Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  payment       Payment    @relation(fields: [centerId, paymentId], references: [centerId, id], onDelete: Restrict)
  charge        FeeCharge  @relation(fields: [centerId, chargeId], references: [centerId, id], onDelete: Restrict)

  @@unique([centerId, paymentId, chargeId])
  @@index([centerId])
  @@index([centerId, paymentId])
  @@index([centerId, chargeId])
}

model CenterCounter {
  centerId  String   @db.Uuid
  name      String
  value     BigInt   @default(0) @db.BigInt
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@id([centerId, name])
  @@index([centerId])
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  centerId      String              @db.Uuid
  studentId     String              @db.Uuid
  parentUserId  String?             @db.Uuid
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  payload       Json
  dedupeKey     String
  createdAt     DateTime            @default(now())
  sentAt        DateTime?
  error         String?
  skippedReason String?
  center        Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student       Student             @relation(fields: [centerId, studentId], references: [centerId, id], onDelete: Cascade)
  parent        User?               @relation("NotificationParent", fields: [parentUserId], references: [id], onDelete: SetNull)

  @@unique([centerId, id])
  @@unique([centerId, dedupeKey])
  @@index([centerId])
  @@index([centerId, status, createdAt])
  @@index([centerId, studentId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  centerId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   Role?
  action      String
  entityType  String
  entityId    String?
  metadata    Json
  requestId   String?
  ip          String?
  createdAt   DateTime @default(now())
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([centerId, createdAt])
  @@index([centerId, action, createdAt])
  @@index([centerId, entityType, entityId, createdAt])
  @@index([centerId, actorUserId, createdAt])
}

model JobOutbox {
  id          String          @id @default(uuid()) @db.Uuid
  centerId    String          @db.Uuid
  month       String
  date        String
  status      JobOutboxStatus @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  dispatchedAt DateTime?
  center      Center          @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([centerId, id])
  @@index([centerId])
  @@index([centerId, status, createdAt])
}
